<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Dibutuhkan WebDisbunActivity untuk memuat situs Disbun Riau -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sistra">

        <!-- 01 Login = HALAMAN AWAL -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.DaftarAkunActivity"
            android:exported="false" />

        <activity
            android:name=".dashboard.DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".harga.HargaTbsActivity"
            android:exported="false" />

        <activity
            android:name=".web.WebDisbunActivity"
            android:exported="false" />

        <!-- Latihan snack (tidak diubah, tetap memakai tema lama) -->
        <activity
            android:name=".SnackHomeActivity"
            android:exported="false"
            android:label="@string/snack_app_name"
            android:theme="@style/Theme.Ramkeripik" />

        <activity
            android:name=".SnackDetailActivity"
            android:exported="false"
            android:label="@string/snack_detail_title"
            android:theme="@style/Theme.Ramkeripik" />

    </application>

</manifest>
