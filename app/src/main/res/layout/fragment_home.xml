<?xml version="1.0" encoding="utf-8"?>
<!-- Tab Beranda (dulu activity_dashboard.xml) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sistra_bg"
    tools:context=".home.HomeFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/sistra_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextAppearance="@style/TextAppearance.Sistra.ToolbarTitle"
        app:titleTextColor="@color/white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- ===== Header hijau ===== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@color/sistra_green"
                android:paddingStart="20dp"
                android:paddingTop="4dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvSapaan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/rubik_regular"
                    tools:text="Halo, Ramos!"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@id/tvInisial"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvJudulDashboard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/rubik_semibold"
                    android:text="@string/dashboard_judul"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    app:layout_constraintEnd_toStartOf="@id/tvInisial"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSapaan" />

                <TextView
                    android:id="@+id/tvInisial"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_lingkaran_putih"
                    android:fontFamily="@font/rubik_semibold"
                    android:gravity="center"
                    tools:text="RH"
                    android:textColor="@color/sistra_green"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvJudulDashboard"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvSapaan" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ===== 4 menu kotak 66dp (rantai horizontal spread) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCatatPanen"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/sistra_blue"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toStartOf="@id/cardRiwayat"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutHeader">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/dashboard_menu_catat_panen"
                    android:src="@drawable/ic_catat_panen" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRiwayat"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/sistra_green"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toStartOf="@id/cardKebun"
                app:layout_constraintStart_toEndOf="@id/cardCatatPanen"
                app:layout_constraintTop_toTopOf="@id/cardCatatPanen">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/dashboard_menu_riwayat"
                    android:src="@drawable/ic_riwayat" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKebun"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/sistra_orange"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toStartOf="@id/cardRekap"
                app:layout_constraintStart_toEndOf="@id/cardRiwayat"
                app:layout_constraintTop_toTopOf="@id/cardCatatPanen">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/dashboard_menu_kebun"
                    android:src="@drawable/ic_kebun" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRekap"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/sistra_red"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardKebun"
                app:layout_constraintTop_toTopOf="@id/cardCatatPanen">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/dashboard_menu_rekap"
                    android:src="@drawable/ic_rekap" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Label menu 11sp di bawah setiap kotak -->
            <TextView
                android:id="@+id/tvLabelCatatPanen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/rubik_regular"
                android:text="@string/dashboard_menu_catat_panen"
                android:textColor="@color/sistra_text"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="@id/cardCatatPanen"
                app:layout_constraintStart_toStartOf="@id/cardCatatPanen"
                app:layout_constraintTop_toBottomOf="@id/cardCatatPanen" />

            <TextView
                android:id="@+id/tvLabelRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/rubik_regular"
                android:text="@string/dashboard_menu_riwayat"
                android:textColor="@color/sistra_text"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="@id/cardRiwayat"
                app:layout_constraintStart_toStartOf="@id/cardRiwayat"
                app:layout_constraintTop_toBottomOf="@id/cardRiwayat" />

            <TextView
                android:id="@+id/tvLabelKebun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/rubik_regular"
                android:text="@string/dashboard_menu_kebun"
                android:textColor="@color/sistra_text"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="@id/cardKebun"
                app:layout_constraintStart_toStartOf="@id/cardKebun"
                app:layout_constraintTop_toBottomOf="@id/cardKebun" />

            <TextView
                android:id="@+id/tvLabelRekap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/rubik_regular"
                android:text="@string/dashboard_menu_rekap"
                android:textColor="@color/sistra_text"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="@id/cardRekap"
                app:layout_constraintStart_toStartOf="@id/cardRekap"
                app:layout_constraintTop_toBottomOf="@id/cardRekap" />

            <!-- ===== Section Harga TBS ===== -->
            <TextView
                android:id="@+id/tvJudulHarga"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/rubik_medium"
                android:text="@string/dashboard_harga_judul"
                android:textColor="@color/sistra_text"
                android:textSize="16sp"
                app:layout_constraintEnd_toStartOf="@id/tvLihatSemuaHarga"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLabelCatatPanen" />

            <TextView
                android:id="@+id/tvLihatSemuaHarga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:fontFamily="@font/rubik_medium"
                android:padding="4dp"
                android:text="@string/dashboard_lihat_semua"
                android:textColor="@color/sistra_green"
                android:textSize="13sp"
                app:layout_constraintBaseline_toBaselineOf="@id/tvJudulHarga"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvJudulHarga" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHargaKebun1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toStartOf="@id/cardHargaKebun2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvJudulHarga">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvLabelKebun1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/rubik_regular"
                        android:text="@string/dashboard_kebun1_label"
                        android:textColor="@color/sistra_text_gray"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvHargaKebun1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/rubik_semibold"
                        android:text="@string/dashboard_kebun1_harga"
                        android:textColor="@color/sistra_text"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvSatuanKebun1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/rubik_regular"
                        android:text="@string/dashboard_satuan_harga"
                        android:textColor="@color/sistra_text_gray"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHargaKebun2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="20dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardHargaKebun1"
                app:layout_constraintTop_toTopOf="@id/cardHargaKebun1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvLabelKebun2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/rubik_regular"
                        android:text="@string/dashboard_kebun2_label"
                        android:textColor="@color/sistra_text_gray"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvHargaKebun2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/rubik_semibold"
                        android:text="@string/dashboard_kebun2_harga"
                        android:textColor="@color/sistra_text"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvSatuanKebun2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/rubik_regular"
                        android:text="@string/dashboard_satuan_harga"
                        android:textColor="@color/sistra_text_gray"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvPeriodeHarga"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:fontFamily="@font/rubik_regular"
                android:text="@string/dashboard_periode_harga"
                android:textColor="@color/sistra_text_gray"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardHargaKebun1" />

            <!-- ===== Tombol ke WebView Disbun ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWebDisbun"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="20dp"
                android:backgroundTint="@color/sistra_green"
                android:fontFamily="@font/rubik_medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/dashboard_tombol_web"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:cornerRadius="6dp"
                app:icon="@drawable/ic_web"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPeriodeHarga" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
